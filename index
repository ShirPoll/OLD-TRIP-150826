<!DOCTYPE html> 
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>חופשה רומנטית באתונה 🇬🇷</title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0056b3;
            --primary-dark: #003366;
            --accent: #28a745;
            --bg-color: #f4f7f6;
            --card-bg: #ffffff;
            --text-main: #2c3e50;
            --border-radius: 12px;
            --shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        body {
            font-family: 'Rubik', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            direction: rtl;
            padding-bottom: 50px;
        }

        header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            color: white;
            text-align: center;
            padding: 30px 20px;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        header h1 {
            margin: 0 0 8px 0;
            font-size: 26px;
        }

        header p {
            margin: 4px 0;
            opacity: 0.9;
        }

        .container {
            max-width: 800px;
            margin: 20px auto;
            padding: 0 15px;
        }

        .nav-tabs {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 25px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .nav-tab {
            flex: 1;
            min-width: 80px;
            text-align: center;
            padding: 12px 6px;
            background: white;
            border: 2px solid transparent;
            border-radius: var(--border-radius);
            font-weight: 500;
            cursor: pointer;
            box-shadow: var(--shadow);
            transition: all 0.2s ease;
            font-size: 13px;
        }

        .nav-tab.active {
            border-color: var(--primary);
            background-color: #eaf2f8;
            color: var(--primary-dark);
            font-weight: 700;
        }

        .day-section {
            display: none;
        }

        .day-section.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .timeline-item {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 16px 20px;
            margin-bottom: 15px;
            box-shadow: var(--shadow);
            display: flex;
            gap: 15px;
            align-items: flex-start;
            border-right: 4px solid var(--primary);
        }

        .checkbox-container input {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: var(--primary);
            margin-top: 3px;
        }

        .content { flex: 1; }

        .time-badge {
            display: inline-block;
            background: #eaf2f8;
            color: var(--primary-dark);
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .item-title {
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 6px 0;
            color: var(--primary-dark);
        }

        .item-desc {
            font-size: 14px;
            line-height: 1.5;
            color: #4a5568;
            margin-bottom: 10px;
        }

        .restaurant-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
        }

        .restaurant-name {
            font-weight: 700;
            font-size: 15px;
            color: var(--primary-dark);
            margin-bottom: 4px;
        }

        .btn-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background-color: #ffffff;
            color: var(--primary);
            text-decoration: none;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 500;
            margin-top: 4px;
            margin-left: 5px;
            border: 1px solid #cbd5e1;
        }

        .btn-link.ticket {
            background-color: #e6f4ea;
            color: #137333;
            border-color: #ceead6;
        }

        .done {
            opacity: 0.4;
            text-decoration: line-through;
        }

        .appendix-card {
            background: white;
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        .list-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 12px;
            padding: 0;
            list-style: none;
        }

        .list-grid li {
            background: #f8fafc;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #edf2f7;
            font-size: 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
    </style>
</head>
