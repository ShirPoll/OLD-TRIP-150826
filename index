    <script>
        function switchDay(dayId, element) {
            document.querySelectorAll('.day-section').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-tab').forEach(el => el.classList.remove('active'));
            
            document.getElementById(dayId).classList.add('active');
            element.classList.add('active');
        }

        function toggleDone(checkbox) {
            const content = checkbox.closest('.timeline-item').querySelector('.content');
            if (checkbox.checked) {
                content.classList.add('done');
            } else {
                content.classList.remove('done');
            }
        }
    </script>
